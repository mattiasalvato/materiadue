---
// src/components/Hero.astro
---

<section class="relative min-h-[100svh] w-full flex flex-col justify-center items-center overflow-hidden bg-[#111820] text-white select-none px-6 pt-20 pb-10 sm:py-24">
  
  <!-- FOTOGRAFIA FULL-BLEED -->
  <div class="absolute inset-0 z-0 overflow-hidden">
    <img 
      src="https://images.unsplash.com/photo-1620626011761-996317b8d101?auto=format&fit=crop&w=2560&q=90" 
      alt="Bagno di lusso con grandi lastre e finiture materiche"
      class="hero-bg w-full h-full object-cover object-[center_right] sm:object-center"
      loading="eager"
      fetchpriority="high"
    />

    <!-- Overlay scuro bilanciato -->
    <div class="absolute inset-0 bg-[#111820]/60 sm:bg-black/35 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#111820]/85 via-[#111820]/30 to-[#111820]/95 pointer-events-none"></div>
  </div>

  <!-- BLOCCO TESTI CENTRALE -->
  <div class="relative z-10 max-w-[980px] w-full mx-auto flex flex-col items-center text-center">
    
    <!-- Titolo principale: scala monumentale e proporzionata su mobile -->
    <h1 class="animate-fade-in-up font-serif font-normal text-[3.25rem] sm:text-6xl md:text-7xl lg:text-[5.4rem] tracking-tight leading-[1.03] text-white drop-shadow-[0_4px_24px_rgba(0,0,0,0.9)] max-w-4xl mb-6">
      Ristrutturiamo <br />
      il tuo spazio, <br />
      <span class="font-serif italic font-light text-[#D98B6E]">ispiriamo</span> la tua casa.
    </h1>

    <!-- Paragrafo descrittivo con corpo netto e largo -->
    <p class="animate-fade-in-up delay-100 font-sans text-base sm:text-lg font-light text-white/95 max-w-md sm:max-w-xl leading-relaxed mb-8 sm:mb-10 drop-shadow-[0_2px_10px_rgba(0,0,0,0.85)] px-2">
      Dalla ristrutturazione completa del bagno alla posa di grandi lastre. Gestiamo ogni fase con cura artigianale e tempi garantiti.
    </p>

    <!-- Tasto CTA a tutta larghezza e tocco agevole -->
    <div class="animate-fade-in-up delay-200 w-full max-w-sm sm:max-w-none sm:w-auto flex justify-center px-2">
      <a 
        href="#preventivo" 
        class="inline-flex w-full sm:w-auto justify-center items-center gap-3.5 bg-[#161E28]/95 sm:bg-[#161E28]/90 hover:bg-[#C97055] text-white text-[13px] font-medium tracking-[0.16em] uppercase px-9 py-4 rounded-full border border-white/20 hover:border-[#C97055] transition-all duration-300 shadow-2xl backdrop-blur-md active:scale-95"
      >
        <span>Richiedi un Preventivo</span>
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none">
          <path d="M1 8H15M15 8L8 1M15 8L8 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

  </div>

</section>

<style>
  .hero-bg {
    animation: slowDrift 24s ease-in-out infinite alternate;
  }

  @keyframes slowDrift {
    0% { transform: scale(1); }
    100% { transform: scale(1.05); }
  }
</style>